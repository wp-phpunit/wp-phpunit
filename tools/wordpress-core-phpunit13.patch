+
+    foreach (get_taxonomies([], 'objects') as $t) {
+        if ($t->publicly_queryable && ! empty($t->query_var)) {
+            $GLOBALS['wp']->add_query_var($t->query_var);
+        }
+    }
+
+    foreach (get_post_types([], 'objects') as $t) {
+        if (is_post_type_viewable($t) && ! empty($t->query_var)) {
+            $GLOBALS['wp']->add_query_var($t->query_var);
+        }
+    }
 }
 
