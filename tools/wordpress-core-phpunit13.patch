diff --git a/migrate-remaining-phpunit-metadata.php b/migrate-remaining-phpunit-metadata.php
new file mode 100644
index 0000000..b0fa30a
--- /dev/null
+++ b/migrate-remaining-phpunit-metadata.php
@@ -0,0 +1,61 @@
+<?php
+
+declare(strict_types=1);
+
+$iterator = new RecursiveIteratorIterator(
+    new RecursiveDirectoryIterator(__DIR__ . '/tests/phpunit/tests'),
+);
+
+foreach ($iterator as $file) {
+    if (!$file->isFile() || $file->getExtension() !== 'php') {
+        continue;
+    }
+
+    $path = $file->getPathname();
+    $code = file_get_contents($path);
+    if ($code === false) {
+        throw new RuntimeException("Cannot read {$path}");
+    }
+
+    $updated = preg_replace_callback(
+        '~(?<doc>/\*\*.*?\*/)(?<space>\R[ \t]*)(?<declaration>(?:(?:final|abstract|public|protected|private|static)\s+)*(?:class|function)\s+)~s',
+        static function (array $match): string {
+            $attributes = [];
+            $doc = preg_replace_callback(
+                '~^[ \t]*\*[ \t]*@(dataProvider|group|requires|test)\b([^\r\n*]*)[ \t]*$~m',
+                static function (array $tag) use (&$attributes): string {
+                    $name = $tag[1];
+                    $value = trim($tag[2]);
+
+                    $attributes[] = match ($name) {
+                        'dataProvider' => sprintf("#[\\PHPUnit\\Framework\\Attributes\\DataProvider('%s')]", $value),
+                        'group' => sprintf("#[\\PHPUnit\\Framework\\Attributes\\Group('%s')]", $value),
+                        'requires' => str_starts_with($value, 'function ')
+                            ? sprintf("#[\\PHPUnit\\Framework\\Attributes\\RequiresFunction('%s')]", substr($value, 9))
+                            : throw new RuntimeException("Unsupported @requires value: {$value}"),
+                        'test' => '#[\\PHPUnit\\Framework\\Attributes\\Test]',
+                    };
+
+                    return '';
+                },
+                $match['doc'],
+            );
+
+            if ($doc === null || $attributes === []) {
+                return $match[0];
+            }
+
+            $indent = substr($match['space'], strrpos($match['space'], "\n") + 1);
+            return $doc . $match['space'] . implode("\n{$indent}", $attributes) . "\n{$indent}" . $match['declaration'];
+        },
+        $code,
+    );
+
+    if ($updated === null) {
+        throw new RuntimeException("Cannot transform {$path}");
+    }
+
+    if ($updated !== $code && file_put_contents($path, $updated) === false) {
+        throw new RuntimeException("Cannot write {$path}");
+    }
+}
