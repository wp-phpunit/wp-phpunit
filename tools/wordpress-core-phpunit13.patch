diff --git a/prepare-wordpress-core-tests.php b/prepare-wordpress-core-tests.php
new file mode 100644
index 0000000..65ae36e
--- /dev/null
+++ b/prepare-wordpress-core-tests.php
@@ -0,0 +1,175 @@
+<?php
+
+declare(strict_types=1);
+
+$write = in_array('--write', $argv, true);
+$root  = realpath(__DIR__);
+
+if ($root === false) {
+	fwrite(STDERR, "Unable to resolve the WordPress Core directory.\n");
+	exit(1);
+}
+
+$testsDirectory = $root . '/tests/phpunit/tests';
+$iterator       = new RecursiveIteratorIterator(
+	new RecursiveDirectoryIterator($testsDirectory, FilesystemIterator::SKIP_DOTS),
+);
+$renames        = array();
+$excludes       = array();
+
+foreach ($iterator as $file) {
+	if (!$file->isFile() || $file->getExtension() !== 'php') {
+		continue;
+	}
+
+	$path       = $file->getPathname();
+	$classNames = concrete_test_classes(file_get_contents($path));
+
+	if ($classNames === array()) {
+		$excludes[] = substr($path, strlen($root) + 1);
+		continue;
+	}
+
+	$className = $classNames[0];
+	$basename  = pathinfo($path, PATHINFO_FILENAME);
+
+	if (str_ends_with(strtolower($className), strtolower($basename))) {
+		continue;
+	}
+
+	$target = dirname($path) . '/' . $className . '.php';
+
+	if (file_exists($target)) {
+		throw new RuntimeException("Cannot rename {$path}: {$target} already exists.");
+	}
+
+	$renames[$path] = $target;
+}
+
+ksort($renames);
+sort($excludes);
+
+foreach ($renames as $source => $target) {
+	printf("rename %s -> %s\n", substr($source, strlen($root) + 1), substr($target, strlen($root) + 1));
+
+	if ($write && !rename($source, $target)) {
+		throw new RuntimeException("Unable to rename {$source} to {$target}.");
+	}
+}
+
+foreach ($excludes as $exclude) {
+	printf("exclude %s\n", $exclude);
+}
+
+if ($write) {
+	foreach (array($root . '/phpunit.xml.dist', $root . '/tests/phpunit/multisite.xml') as $configurationPath) {
+		if (!is_file($configurationPath)) {
+			continue;
+		}
+
+		$configuration = file_get_contents($configurationPath);
+
+		foreach ($renames as $source => $target) {
+			$configuration = str_replace(
+				substr($source, strlen($root) + 1),
+				substr($target, strlen($root) + 1),
+				$configuration,
+			);
+		}
+
+		$excludeElements = '';
+
+		foreach ($excludes as $exclude) {
+			if (!str_contains($configuration, ">{$exclude}<")) {
+				$excludeElements .= "      <exclude>{$exclude}</exclude>\n";
+			}
+		}
+
+		if ($excludeElements !== '') {
+			$configuration = preg_replace(
+				'/([ \t]*)<\/testsuite>/',
+				$excludeElements . '$1</testsuite>',
+				$configuration,
+				1,
+			);
+		}
+
+		file_put_contents($configurationPath, $configuration);
+	}
+}
+
+printf("Summary: %d renames, %d excludes.\n", count($renames), count($excludes));
+
+/**
+ * @return list<string>
+ */
+function concrete_test_classes(string $source): array
+{
+	$tokens         = token_get_all($source);
+	$classNames     = array();
+	$abstract       = false;
+	$tokenCount     = count($tokens);
+	$testBaseSuffix = 'testcase';
+
+	for ($index = 0; $index < $tokenCount; ++$index) {
+		$token = $tokens[$index];
+
+		if (is_array($token) && $token[0] === T_ABSTRACT) {
+			$abstract = true;
+			continue;
+		}
+
+		if (!is_array($token) || $token[0] !== T_CLASS) {
+			continue;
+		}
+
+		for ($previousIndex = $index - 1; $previousIndex >= 0; --$previousIndex) {
+			$previous = $tokens[$previousIndex];
+
+			if (is_array($previous) && in_array($previous[0], array(T_WHITESPACE, T_COMMENT, T_DOC_COMMENT), true)) {
+				continue;
+			}
+
+			if (is_array($previous) && $previous[0] === T_DOUBLE_COLON) {
+				continue 2;
+			}
+
+			break;
+		}
+
+		$name   = null;
+		$parent = null;
+
+		for (++$index; $index < $tokenCount; ++$index) {
+			$current = $tokens[$index];
+
+			if (is_array($current) && $current[0] === T_STRING && $name === null) {
+				$name = $current[1];
+				continue;
+			}
+
+			if (is_array($current) && $current[0] === T_EXTENDS) {
+				for (++$index; $index < $tokenCount; ++$index) {
+					$parentToken = $tokens[$index];
+
+					if (is_array($parentToken) && in_array($parentToken[0], array(T_STRING, T_NAME_QUALIFIED, T_NAME_FULLY_QUALIFIED), true)) {
+						$parent = $parentToken[1];
+						break;
+					}
+				}
+			}
+
+			if ($current === '{') {
+				break;
+			}
+		}
+
+		if (!$abstract && $name !== null && $parent !== null && str_ends_with(strtolower($parent), $testBaseSuffix)) {
+			$classNames[] = $name;
+		}
+
+		$abstract = false;
+	}
+
+	return $classNames;
+}
