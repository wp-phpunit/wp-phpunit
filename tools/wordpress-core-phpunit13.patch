+    /**
+     * Starts a database transaction.
+     *
+     * @global wpdb $wpdb WordPress database abstraction object.
+     */
+    public function start_transaction()
+    {
+        global $wpdb;
+
+        $wpdb->query('SET autocommit = 0;');
+        $wpdb->query('START TRANSACTION;');
