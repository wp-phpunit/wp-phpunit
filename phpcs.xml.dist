<?xml version="1.0"?>
<ruleset name="WordPress PHPUnit 13 Harness">
    <description>PHP 8.5 compatibility gate for the WordPress PHPUnit harness.</description>

    <file>includes</file>
    <file>__loaded.php</file>
    <file>wp-tests-config.php</file>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="p"/>

    <config name="testVersion" value="8.5-"/>
    <rule ref="PHPCompatibility"/>
    <rule ref="PHPCompatibility.Extensions.RemovedExtensions.mysql_DeprecatedRemoved">
        <exclude-pattern>includes/testcase-rest-post-type-controller.php</exclude-pattern>
    </rule>
</ruleset>
