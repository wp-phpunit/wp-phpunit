+    /**
+     * Executes a callback while capturing native PHP deprecations and asserts
+     * that every captured message matches the expected regular expression.
+     *
+     * PHPUnit 13 only provides expectations for user deprecations. WordPress
+     * Core also tests behavior that intentionally reaches native PHP
+     * deprecations, so those expectations need an explicit, assertion-backed
+     * boundary.
+     */
+    protected function assertExpectedPhpDeprecations(string $pattern, callable $callback): void
+    {
+        $deprecations = [];
+
+        set_error_handler(
+            static function (int $severity, string $message) use (&$deprecations): bool {
+                if ($severity !== E_DEPRECATED) {
+                    return false;
+                }
+
+                $deprecations[] = $message;
+
+                return true;
+            },
+        );
+
+        try {
+            $callback();
+        } finally {
+            restore_error_handler();
+        }
+
+        $this->assertNotEmpty($deprecations, 'Failed to capture an expected native PHP deprecation.');
+
+        foreach ($deprecations as $deprecation) {
+            $this->assertMatchesRegularExpression($pattern, $deprecation);
+        }
+    }
+
+    protected function assertExpectedUserDeprecation(string $expectedMessagePart, callable $callback): void
+    {
+        $deprecations = [];
+
+        set_error_handler(
+            static function (int $severity, string $message) use (&$deprecations): bool {
+                if ($severity !== E_USER_DEPRECATED) {
+                    return false;
+                }
+
+                $deprecations[] = $message;
+
+                return true;
+            },
+        );
+
+        try {
+            $callback();
+        } finally {
+            restore_error_handler();
+        }
+
+        $this->assertCount(1, $deprecations, 'Expected exactly one user deprecation.');
+        $this->assertStringContainsString($expectedMessagePart, $deprecations[0]);
+    }
