+function _cleanup_query_vars()
+{
+    // Clean out globals to stop them polluting wp and wp_query.
+    foreach ($GLOBALS['wp']->public_query_vars as $v) {
+        unset($GLOBALS[ $v ]);
+    }
+
+    foreach ($GLOBALS['wp']->private_query_vars as $v) {
+        unset($GLOBALS[ $v ]);
