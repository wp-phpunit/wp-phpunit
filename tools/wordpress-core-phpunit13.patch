+            'ino'     => 0,
+            'mode'    => 0,
+            'nlink'   => 0,
+            'uid'     => 0,
+            'gid'     => 0,
+            'rdev'    => 0,
+            'size'    => 0,
+            'atime'   => 0,
+            'mtime'   => 0,
+            'ctime'   => 0,
+            'blksize' => 0,
+            'blocks'  => 0,
+        ];
+
+        return array_merge($defaults, $stats);
+    }
+
+    /**
+     * Retrieves information about a file.
+     *
+     * @see streamWrapper::stream_stat
+     */
+    public function stream_stat()
+    {
