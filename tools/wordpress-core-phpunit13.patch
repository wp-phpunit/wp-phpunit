+    /**
+     * Returns a list of all files contained inside the `uploads` directory.
+     *
+     * @since 4.0.0
+     *
+     * @return string[] List of file paths.
+     */
+    public function scan_user_uploads()
+    {
+        static $files = [];
+        if (! empty($files)) {
+            return $files;
+        }
+
+        $uploads = wp_upload_dir();
+        $files   = $this->files_in_dir($uploads['basedir']);
+        return $files;
+    }
