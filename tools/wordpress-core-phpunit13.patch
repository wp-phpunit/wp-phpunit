+        $new_offset = $this->position;
+        switch ($whence) {
+            case SEEK_CUR:
+                $new_offset += $offset;
+                break;
+
+            case SEEK_END:
+                $new_offset = \strlen($this->data_ref) + $offset;
+                break;
+
+            case SEEK_SET:
+                $new_offset = $offset;
+                break;
