+     *
+     * @since 4.0.0
+     *
+     * @param string $path Directory path.
+     */
+    public function rmdir($path)
+    {
+        $files = $this->files_in_dir($path);
+        foreach ($files as $file) {
+            if (! \in_array($file, self::$ignore_files, true)) {
+                $this->unlink($file);
+            }
+        }
+    }
